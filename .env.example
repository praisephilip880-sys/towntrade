[TEMPLATE]
# Copy to .env.local and fill in your own values.
# Get test keys at https://dashboard.stripe.com/test/apikeys
# Get live keys at https://dashboard.stripe.com/apikeys (switch to Live mode)

# Secret key — server-side ONLY. Never expose this to the browser.
# Paste your real sk_test_... value into .env.local (NOT this file).
STRIPE_SECRET_KEY=replace_me_with_your_stripe_test_key

# Publishable key — safe to ship to the browser (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_me_with_your_publishable_key

# Webhook signing secret from https://dashboard.stripe.com/webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=replace_me_with_your_webhook_secret

# Absolute base URL used in Stripe success/return URLs (empty = auto-detect).
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Hosted cloud database (OPTIONAL on your own machine, REQUIRED on Vercel).
# Vercel's serverless servers have a read-only filesystem and cannot save the
# local SQLite file, so the app falls back to this cloud database when set.
#
# Create a FREE database (500MB) at https://turso.tech -> Create database.
# Copy the two values Turso shows you (they match the names below exactly):
#   TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
# Then add them to Vercel -> Project -> Settings -> Environment Variables.
# Local development ignores these and keeps using the data/towntrade.db file.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=replace_me_with_your_turso_token

# ---------------------------------------------------------------------------
# Background push notifications (Web Push, works in any browser).
# Generate a fresh pair at https://vapidkeys.com or with: npx web-push generate-vapid-keys
# The PUBLIC key is shipped to the browser (NEXT_PUBLIC_...); the PRIVATE key
# stays server-side. VAPID_SUBJECT is a mailto: or https: contact for the push
# service. Push silently disables if these are missing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_me_with_your_vapid_public_key
VAPID_PRIVATE_KEY=replace_me_with_your_vapid_private_key
VAPID_SUBJECT=mailto:praisephilip880@gmail.com

# ---------------------------------------------------------------------------
# Real AI chatbot (OpenRouter — free tier, no card needed).
# Get a free key at https://openrouter.ai/keys
# Model: free models work with the ":free" suffix, e.g. meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=replace_me_with_your_openrouter_key
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------------------------------------------------------
# WhatsApp milestone alerts (Twilio WhatsApp Sandbox — free trial).
# 1. Create a Twilio account: https://www.twilio.com/try-twilio
# 2. Console shows your Account SID + Auth Token.
# 3. Messaging -> Try it out -> WhatsApp: activate the Sandbox.
# 4. Join the sandbox from YOUR phone by texting the join code.
# TWILIO_WHATSAPP_FROM is the sandbox number (whatsapp:+14155238886 by default).
# ADMIN_WHATSAPP_TO is the number that receives milestone alerts (your phone).
# Alerts silently no-op until these are set.
TWILIO_ACCOUNT_SID=replace_me_with_your_twilio_sid
TWILIO_AUTH_TOKEN=replace_me_with_your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ADMIN_WHATSAPP_TO=whatsapp:+2348121344178

# ---------------------------------------------------------------------------
# Multi-currency display rates (OPTIONAL).
# Listing prices are stored in USD cents; the app converts them for display
# using built-in approximate rates. Override any rate (units per 1 USD) here:
#   EXCHANGE_RATES_JSON={"NGN":1600,"EUR":0.92,"GBP":0.79}
EXCHANGE_RATES_JSON=
